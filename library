#!/usr/bin/env python3
from pathlib import Path
import runpy
import sys
import os
root = Path(__file__).resolve().parent
if len(sys.argv)>1 and sys.argv[1]=='remote':
    sys.argv.pop(1)
    if '--credential' not in sys.argv and not os.environ.get('COMMONPLACE_CREDENTIAL') and (root/'.secrets/owner-publisher.json').is_file():
        sys.argv[1:1]=['--credential',str(root/'.secrets/owner-publisher.json')]
    runpy.run_path(str(root/'scripts/remote_publish.py'), run_name='__main__')
else:
    runpy.run_path(str(root/'scripts/library.py'), run_name='__main__')
